# Device-class profile: fallback when auto-detection can't classify the device
# (no /etc/nv_tegra_release, or an unrecognised L4T release). Sourced by
# deploy/run-node.sh (see orin.env for how profiles work).
#
# No extra flags: full-resolution cloud, no pose. Set NODE_PROFILE=orin/nano
# in /etc/default/kinect-node to pick a class explicitly.
PROFILE_EXTRA_ARGS=''
