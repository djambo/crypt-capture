# crypt-capture Kinect node — per-device configuration.
# Installed to /etc/default/kinect-node and read by the kinect-node systemd unit.
# After editing:  sudo systemctl restart kinect-node

# Central machine running central.preview_server.
#   auto          = find it on the LAN by rig id (recommended; survives the
#                   central laptop getting a new DHCP IP). Needs the relay
#                   running with discovery enabled (the default).
#   <ip/hostname> = connect to a fixed address instead.
CENTRAL_HOST=auto
# TCP port for a fixed CENTRAL_HOST. Ignored when CENTRAL_HOST=auto (discovery
# returns the relay's own node port).
CENTRAL_PORT=9000

# This node's sensor id (0..N-1; one per Kinect/Jetson):
SENSOR_ID=0

# Device-class profile (deploy/profiles/<name>.env, stored IN THE REPO so its
# defaults roll out via the auto-update — e.g. the Orin's skeleton-pose flags).
#   auto = detect from the L4T release: JetPack 5/6+ (Orin) -> orin,
#          JetPack 4 (1st-gen Nano) -> nano, unknown -> default (no flags).
#   orin | nano | default = force a class.
# Flags in EXTRA_ARGS below are appended AFTER the profile's, so a repeated
# flag here overrides the profile (argparse last-wins).
NODE_PROFILE=auto

# Self-update: on every (re)start, fetch + hard-reset the code to the remote so a
# reboot runs the latest pushed code. Non-fatal — offline just runs on-disk code.
#   AUTO_UPDATE   1 = update on start (default), 0 = never touch the code
#   UPDATE_BRANCH branch to track (after this work merges, leave it at main)
# Hard reset DISCARDS any local edits on the Jetson — edit via push, not on-device.
AUTO_UPDATE=1
UPDATE_BRANCH=main

# Cold-boot note: the Kinect's depth camera must be powered + ready BEFORE the
# host enumerates it, or it won't appear on USB (no software reset reliably fixes
# this on the Jetson). The reliable flow is: boot the Jetson first, then connect
# the Kinect (barrel-jack power, then USB). The service retries continuously, so
# it grabs the camera as soon as it appears — no manual launch needed.

# Azure Kinect depth engine needs a GPU/OpenGL context. A bare systemd service
# has no DISPLAY, so the depth engine fails with "error code: 204" — even though
# launching by hand from the desktop works. These point the service at the
# running X session so it can borrow its GL context, and are REQUIRED on the
# JetPack 6 Xorg + GDM autologin setup (docs/jetson_orin_node_setup.md §3) — so
# they ship enabled. The values below are correct for the first user (uid 1000)
# under GDM autologin; verify against your session and only change if they differ:
#   DISPLAY:    `echo $DISPLAY` in a desktop terminal (usually :0)
#   XAUTHORITY: `ps -C Xorg -o args= | grep -o '\-auth [^ ]*'`
#               (/run/user/1000/gdm/Xauthority under GDM, ~/.Xauthority under lightdm)
DISPLAY=:0
XAUTHORITY=/run/user/1000/gdm/Xauthority

# Extra kinect_node flags, whitespace-separated, appended AFTER the profile's
# flags (so a flag repeated here overrides the profile). The device-class
# defaults live in the repo (deploy/profiles/): orin = full res + skeleton
# pose (--pose-model models/movenet.onnx --pose-trt; needs the one-time
# onnxruntime-gpu + model download from docs/skeleton_pose.md — until then the
# node just logs "pose disabled" and streams normally), nano = full res, no
# pose. Use this ONLY for true per-device tweaks. Examples:
#   --preview-stride 2          downsample if THIS device's CPU can't hold the
#                               frame rate at full res (not a class default)
#   --align color_to_depth      fewer / cleaner points
#   --depth-mode WFOV_UNBINNED  wide FOV
#   --imu-axes x,z,-y           IMU->depth axis override (see CLAUDE.md)
#   --rig-id studioB            only needed if >1 rig shares the LAN (must match
#                               the relay's --rig-id; default is "crypt")
#   --pose-gate 0.5             stricter person gate on THIS node
#   --sync master               3.5mm hardware sync: give THIS flag to the ONE
#   --sync sub --sub-delay-us 160   camera whose Sync Out feeds the cable chain;
#                               every downstream (Sync In) camera gets sub +
#                               a UNIQUE delay (160, 320, ... = 160*index; all
#                               measured from the master pulse, order arbitrary)
#                               so the ToF lasers don't interfere. Sensor ids
#                               need NOT match the cable order. Per-device by
#                               nature (depends on the physical wiring), so it
#                               can never be a profile default. Default is
#                               standalone = cable ignored.
EXTRA_ARGS=
